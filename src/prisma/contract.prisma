// use prisma-next

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  avatar    String?
  isOnline  Boolean  @default(false)
  lastSeen  TimestamptzString?
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  conversationMembers ConversationMember[]
  messageDeletions    MessageDeletion[]
  reactions           MessageReaction[]
  blockedUsers        UserBlock[] @relation("UserBlocker")
  blockedBy           UserBlock[] @relation("UserBlocked")
  notifications       Notification[]
}

model Notification {
  id             Int               @id @default(autoincrement())
  userId         Int
  type           String            @default("MESSAGE")
  title          String
  message        String
  conversationId Int?
  messageId      Int?
  actorId        Int?
  isRead         Boolean           @default(false)
  createdAt      TimestamptzString @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Conversation {
  id        Int      @id @default(autoincrement())
  type      String   @default("DIRECT")
  name      String?
  avatar    String?
  createdBy Int?
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  members ConversationMember[]
}

model ConversationMember {
  id             Int @id @default(autoincrement())
  conversationId Int
  userId         Int
  role           String @default("MEMBER")
  joinedAt       TimestamptzString @default(now())
  isDeleted      Boolean @default(false)
  deletedAt      TimestamptzString?

  conversation Conversation @relation(
    fields: [conversationId],
    references: [id]
  )

  user User @relation(
    fields: [userId],
    references: [id]
  )
}

model Message {
  id               Int      @id @default(autoincrement())
  conversationId   Int
  senderId         Int
  content          String?
  type             String   @default("TEXT")
  isRead           Boolean  @default(false)
  isDelivered      Boolean  @default(false)
  attachmentUrl    String?
  attachmentName   String?
  attachmentType   String?
  attachmentSize   Int?
  replyToMessageId Int?
  isEdited         Boolean  @default(false)
  editedAt         TimestamptzString?
  isDeleted        Boolean  @default(false)
  deletedAt        TimestamptzString?
  deletedBy        Int?
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString @default(now())

  messageDeletions MessageDeletion[]
  reactions        MessageReaction[]
}

model MessageDeletion {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  createdAt TimestamptzString @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
}

model MessageReaction {
  id        Int      @id @default(autoincrement())
  messageId Int
  userId    Int
  reaction  String
  createdAt TimestamptzString @default(now())
  updatedAt TimestamptzString @default(now())

  message Message @relation(
    fields: [messageId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([messageId, userId])
  @@index([messageId])
}

model UserBlock {
  id        Int      @id @default(autoincrement())
  blockerId Int
  blockedId Int
  createdAt TimestamptzString @default(now())

  blocker User @relation("UserBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("UserBlocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
}